# M06 book-quake TB — drive a synthetic BookEvent stream straight into
# lob_core and assert that per-rebase stall is bounded.
#
# Required env vars (set by Makefile target or caller):
#   M06_BQ_STREAM     Path to the 32 B BookEvent binary stream produced by
#                     `python3 -m sw.m06_tools.synth_bookquake`.
# Optional:
#   M06_BQ_N_SYMS         Expected number of rebases (default 10).
#   M06_BQ_MAX_STALL      Max per-rebase stall in cycles (default 200).
#   V_THREADS             Verilator thread count (default 4).

REPO_ROOT := $(shell git rev-parse --show-toplevel)

TOPLEVEL_LANG := verilog
TOPLEVEL := lob_core
MODULE   := tb_bookquake

# lob_core needs book_event_pkg from itch_decoder, plus all M06 lob_core
# sub-modules. No decoder instance is needed because the TB drives
# book_event_t beats directly onto lob_core.s_*.
PKG_SOURCES := $(REPO_ROOT)/hw/ip/itch_decoder/book_event_pkg.sv

# Pull canonical lob_core source list from hw/ip/lob_core/files.f.
LOB_DIR     := $(REPO_ROOT)/hw/ip/lob_core
LOB_SOURCES := $(addprefix $(LOB_DIR)/,$(shell grep -vE '^[[:space:]]*(\#|$$)' $(LOB_DIR)/files.f))

VERILOG_SOURCES := $(PKG_SOURCES) $(LOB_SOURCES)

VERILATOR_FLAGS := -Wall -Wno-DECLFILENAME -Wno-fatal -Wno-UNUSEDSIGNAL \
                   -I$(REPO_ROOT)/hw/ip/itch_decoder \
                   -I$(REPO_ROOT)/hw/ip/lob_core

V_THREADS ?= 4
ifneq ($(V_THREADS),1)
VERILATOR_FLAGS += --threads $(V_THREADS)
endif
EXTRA_ARGS := $(VERILATOR_FLAGS)

SIM := verilator
SIM_BUILD := sim_build_m06_bookquake

# Python module search path:
#   - this dir            (cocotb resolves MODULE := tb_bookquake)
#   - REPO_ROOT           (sw.m05_tools, sw.m06_tools imports)
#   - dv/unit/lob_core    (_book.pack_book_event / unpack_tob_delta)
export PYTHONPATH := $(REPO_ROOT)/dv/integration/m06_bookquake:$(REPO_ROOT):$(REPO_ROOT)/dv/unit/lob_core

include $(shell cocotb-config --makefiles)/Makefile.sim
