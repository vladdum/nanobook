TOPLEVEL := lob_core
MODULE   := tb_lob_core_smoke
# Phase H wires the orchestrator + 4 sub-modules; lob_core_params_pkg now
# imports + sub-module sources are required here too.
# Source list from the canonical lob_core filelist (one source of truth
# shared with synth, lint, and the integration cosims).
LOB_DIR     := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))../../../hw/ip/lob_core)
LOB_SOURCES := $(addprefix $(LOB_DIR)/,$(shell grep -vE '^[[:space:]]*(\#|$$)' $(LOB_DIR)/files.f))

VERILOG_SOURCES := \
    $(abspath $(dir $(lastword $(MAKEFILE_LIST)))../../../hw/ip/itch_decoder/book_event_pkg.sv) \
    $(LOB_SOURCES)

# Sim-time sizing: small POOL/HASH/window so the Verilator build is fast.
# Post-E.2: SYMBOL_FILTER_ID is no longer the input filter (sym_idx_lut is),
# so the override is dropped; the package default 5754 (AAPL) is in the LUT
# at sym_idx=0 and the smoke TB now drives stock_locate=5754.
EXTRA_ARGS += -GWINDOW_BASE_TICK=10000 -GWINDOW_SIZE_TICKS=64
EXTRA_ARGS += -GPOOL_SLOTS=64 -GHASH_SLOTS=512

include $(dir $(lastword $(MAKEFILE_LIST)))Makefile
