TOPLEVEL  := lob_core
MODULE    := tb_lob_core_rebase
SIM_BUILD := sim_build_lob_core_rebase

# Source list from the canonical lob_core filelist.
LOB_DIR     := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))../../../hw/ip/lob_core)
LOB_SOURCES := $(addprefix $(LOB_DIR)/,$(shell grep -vE '^[[:space:]]*(\#|$$)' $(LOB_DIR)/files.f))

VERILOG_SOURCES := \
    $(abspath $(dir $(lastword $(MAKEFILE_LIST)))../../../hw/ip/itch_decoder/book_event_pkg.sv) \
    $(LOB_SOURCES)

# Same sim-only sizing as Makefile.smoke.
EXTRA_ARGS += -GWINDOW_BASE_TICK=10000 -GWINDOW_SIZE_TICKS=64
EXTRA_ARGS += -GPOOL_SLOTS=64 -GHASH_SLOTS=512

include $(dir $(lastword $(MAKEFILE_LIST)))Makefile
