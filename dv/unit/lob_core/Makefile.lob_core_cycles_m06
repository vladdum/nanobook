TOPLEVEL  := lob_core
MODULE    := tb_lob_core_cycles_m06
# Dedicated sim_build dir — Verilator bakes -G overrides at compile time, so a
# shared dir would silently reuse whichever binary built first (see the
# comment in Makefile.cycles for the failure mode that bit m05_exit.sh).
SIM_BUILD := sim_build_lob_core_cycles_m06

# Pull the canonical lob_core source list from the shared filelist.
LOB_DIR     := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))../../../hw/ip/lob_core)
LOB_SOURCES := $(addprefix $(LOB_DIR)/,$(shell grep -vE '^[[:space:]]*(\#|$$)' $(LOB_DIR)/files.f))

VERILOG_SOURCES := \
    $(abspath $(dir $(lastword $(MAKEFILE_LIST)))../../../hw/ip/itch_decoder/book_event_pkg.sv) \
    $(LOB_SOURCES)

# Sim-only sizing. Post-E.2: SYMBOL_FILTER_ID is no longer the input filter
# (sym_idx_lut is), so the override is dropped; package default 5754 (AAPL)
# is the stock_locate the cycle TB drives.
EXTRA_ARGS += -GWINDOW_BASE_TICK=10000 -GWINDOW_SIZE_TICKS=128
EXTRA_ARGS += -GPOOL_SLOTS=256 -GHASH_SLOTS=512

include $(dir $(lastword $(MAKEFILE_LIST)))Makefile
