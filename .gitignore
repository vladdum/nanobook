*.pyc
.pytest_cache/
.venv/
*.egg-info/

# cocotb / Verilator
sim_build/
sim_build_*/
results.xml
obj_dir/
*.fst
*.vcd
dump.fst

# lob_core unit-TB artefacts (root patterns; per saved feedback, subdir
